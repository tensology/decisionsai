# =============================================================================
# DecisionsAI .gitignore
# =============================================================================

# --- IDE / Editor configs (personal, not project) ---
.claude/
.cursor/
.kiro/
.vscode/
.idea/

# --- Local runtime artifacts (never commit) ---
.artifacts/
*.swp
*.swo
*~
*.kate-swp

# --- OS junk ---
.DS_Store
.thumb
Thumbs.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
.Python
*.egg-info
.installed.cfg
build/
develop-eggs/
eggs/
dist/
db.sqlite3

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Testing / Linting caches ---
.pytest_cache/
.ruff_cache/
.hypothesis/

# --- Runtime / generated data (never commit) ---
*.db
*.pid
llama_index_storage/
logs/*
tmp/
assets/tmp/*
distr/core/db/tool_embeddings_cache.json

# --- Custom voice audio uploads (user data, not source) ---
distr/db/custom_voices/

# --- Optional upstream clone (legacy path; default install uses ~/.cache/decisionsai/) ---
third_party/VibeVoice/

# --- Models (large binaries, downloaded at runtime) ---
models/*
distr/core/agent/models/

# --- Dev scratch & utility scripts (local only) ---
playground/
scripts/*
!scripts/
!scripts/harness_live_proof.py
!scripts/run_workflow_ticket_loop_e2e.sh
!scripts/workflow_ticket_loop_e2e.py
!scripts/deploy_changelog.sh
!scripts/deploy_changelog_to_site.sh
!scripts/humanize_changelog.py
!scripts/cleanup_workflow_loop_smoke.py
!scripts/harness_doctor.py
!scripts/prefetch_local_models.py
!scripts/preflight_local.py
!scripts/setup_project_clis.sh
!scripts/setup_workflow_loop_smoke.py
!scripts/verify_agent_harness_setup.py

# --- Databases ---
db/*
db/backups/
db/whatsapp_media/

# --- Docs (local notes only; tracked canonical docs are allowlisted) ---
docs/*
!docs/orchestrator.md
!docs/local-harness-preflight.md
!docs/nous-hermes-agent.md
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/plans/
docs/superpowers/plans/*
!docs/superpowers/plans/2026-07-04-local-harness-preflight.md
!docs/skills/
docs/skills/*
!docs/skills/reference-skill-integration-assessment.md
!docs/skills/jcode-agentmanager-harness-assessment.md

# --- Dev scratch at repo root ---
.superpowers/
test.js
server.log

# --- Installer build artifacts ---
installer/build/
installer/dist/
installer/*.app
installer/*.dmg
installer/.requirements_installed*
*.spec
*.app
*.dmg
sidecar/sidecar
sidecar/dist/

# --- Recordings ---
distr/recordings/
recordings/

# --- Environment / secrets ---
.env
.env.*
.secret_keys
*.secret_keys
secrets/
!secrets/.gitkeep

# --- macOS app bundle metadata ---
info.plist

# --- VSCode extension ---
vscode_extension/node_modules/

# --- Custom voices / clones (local only) ---
clone/
