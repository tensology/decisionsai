<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tensology.decisions-selfimprove-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>distr.core.mempalace.selfimprove</string>
    <string>nightly</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>__REPO__</string>
    <key>PATH</key><string>__PATH__</string>
  </dict>
  <!-- 02:00 local daily; the job itself exits on odd days-since-epoch (every second night). -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__LOGDIR__/nightly.log</string>
  <key>StandardErrorPath</key><string>__LOGDIR__/nightly.err.log</string>
</dict>
</plist>
