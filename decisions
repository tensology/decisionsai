#!/bin/bash
# Wrapper script for DecisionsAI — runs setup, launches detached, then exits.

if [ -L "$0" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$(readlink "$0")")" && pwd)"
else
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
fi

cd "$SCRIPT_DIR" || exit 1

FOLLOW_LOGS=0
STOP_APP=0
PASSTHROUGH_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --logs|--follow|-f)
            FOLLOW_LOGS=1
            ;;
        --stop|--quit|-q)
            STOP_APP=1
            ;;
        --permissions|--setup-permissions)
            exec "$SCRIPT_DIR/bin/decisions-permissions.sh" "$@"
            ;;
        *)
            PASSTHROUGH_ARGS+=("$arg")
            ;;
    esac
done

if [ "$STOP_APP" = "1" ]; then
    exec "$SCRIPT_DIR/bin/decisions-cleanup.sh"
fi

"$SCRIPT_DIR/bin/decisions.sh" "${PASSTHROUGH_ARGS[@]}"
EXIT_CODE=$?

if [ "$EXIT_CODE" -ne 0 ]; then
    exit "$EXIT_CODE"
fi

LOG_FILE="$HOME/.decisions/logs/decisions.log"

if [ "$FOLLOW_LOGS" = "1" ]; then
    echo ""
    echo "Following logs (Ctrl+C to stop viewing — app keeps running):"
    echo "  $LOG_FILE"
    echo ""
    tail -f "$LOG_FILE"
fi
