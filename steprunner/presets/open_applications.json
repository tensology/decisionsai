      "step_type": "run_command",
      "instruction": "Get basic system information",
      "config": {"command": "uname -a && echo '---' && sw_vers 2>/dev/null || cat /etc/os-release 2>/dev/null || echo 'Unknown OS'"},
      "validation_type": "none",
      "validation_prompt": "",
      "routing_mode": "static",
      "routing_prompt": "",
      "on_pass_goto_position": 1,
