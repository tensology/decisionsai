{
  "format_version": "2.0",
  "format": "decisionsai_workflow_v1",
  "name": "Open Applications and Run Commands",
  "description": "Open applications, run system commands, check for running processes. Tests agent_instruction and run_command step types for desktop automation.",
  "workflow_type": "instruction",
  "context_rules": "Only open applications that are likely installed. Use 'open' command on macOS. Check if apps are running before trying to interact.",
