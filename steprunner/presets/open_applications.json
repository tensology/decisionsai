      "description": "Check what applications are currently running",
      "action_type": "run_command",
      "step_type": "run_command",
      "instruction": "List currently running applications",
      "config": {"command": "ps aux | head -20"},
      "validation_type": "none",
      "validation_prompt": "",
      "routing_mode": "static",
