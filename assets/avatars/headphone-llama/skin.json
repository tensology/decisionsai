{
  "type": "avatar",
  "name": "Llama",
  "rendering": {
    "shape": "square",
    "border": false,
    "shadow": false,
    "glow_on_hold": false,
    "chroma_key": [
      0,
      255,
      0
    ],
    "chroma_threshold": 47,
    "default_size_px": 280
  },
  "events": {
    "idle": {
      "animation": "idle.webm"
    },
    "hands_free_listening": {
      "animation": "hands-free-listening.webm",
      "playback": "pingpong"
    },
    "ptt_active": {
      "animation": "ptt-active.webm",
      "playback": "pingpong"
    },
    "dictation": {
      "animation": "dictation.webm"
    },
    "ticket_dictation": {
      "animation": "ticket-dictation.webm",
      "playback": "pingpong"
    },
    "recording_action": {
      "animation": "recording-action.webm",
      "playback": "pingpong",
      "tray_icon": "recording"
    },
    "file_drop_success": {
      "animation": "file-drop-success.webm",
      "playback": "pingpong"
    },
    "tts_response": {
      "animation": "tts-response.webm",
      "playback": "pingpong",
      "show_player": true
    },
    "talking": {
      "animation": "talking.webm",
      "playback": "pingpong"
    },
    "running_action": {
      "animation": "running-action.webm",
      "playback": "pingpong"
    },
    "running_step_runner": {
      "animation": "running-step-runner.webm",
      "playback": "pingpong"
    },
    "snippet_copied": {
      "animation": "snippet-copied.webm",
      "playback": "pingpong"
    },
    "thinking": {
      "animation": "thinking.webm",
      "playback": "pingpong"
    },
    "needs_attention": {
      "animation": "needs-attention.webm",
      "playback": "pingpong"
    }
  }
}
