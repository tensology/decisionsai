{
  "project": "Ember & Crust Pizza House",
  "objective": "Launch a responsive, accessible restaurant site with a maintainable menu and validated customer journey.",
  "tickets": [
    {"title": "Define visual direction and acceptance criteria", "complexity": "low", "required_capabilities": ["files"]},
    {"title": "Build responsive menu and restaurant landing page", "complexity": "medium", "required_capabilities": ["files", "tools"]},
    {"title": "Validate accessibility, responsive layout, and ordering links", "complexity": "medium", "required_capabilities": ["files", "tools"]},
    {"title": "Independent quality review and correction pass", "complexity": "high", "required_capabilities": ["files", "tools"]}
  ],
  "workflow_policy": {
    "auto_route_models": true,
    "free_only": true,
    "prefer_local": true,
    "independent_validation": true,
    "max_correction_iterations": 3,
    "steps": [
      {"role": "scope", "quality_tier": "economy", "context": ["ticket", "project_memory"]},
      {"role": "implement", "quality_tier": "balanced", "context": ["scope_packet", "project_memory"]},
      {"role": "validate", "quality_tier": "economy", "context": ["acceptance_criteria", "changed_files"]},
      {"role": "review", "quality_tier": "quality", "context": ["validation_evidence", "memory_delta"]}
    ]
  }
}
